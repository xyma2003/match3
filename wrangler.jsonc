{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nailong-match3",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nailong-match3-db",
      "database_id": "95b29c46-7113-401c-8baf-32af4d5063c0",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
